    "smoke": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=1.5.0",
    "react": ">=18.3",
    "react-native": ">=0.75",
    "react-native-gesture-handler": ">=2.20",
    "react-native-reanimated": ">=3.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "playwright": "1.64.1",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  }
}

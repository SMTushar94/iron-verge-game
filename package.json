{
  "name": "iron-verge",
  "version": "1.0.0",
  "private": true,
  "description": "IRON VERGE - 2D side-stepping run-and-gun live-service mobile game",
  "main": "index.js",
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/run-tests.mjs",
    "demo": "node scripts/serve.mjs",
    "snapshot": "node scripts/snapshot-frames.mjs && python3 scripts/rasterize-frames.py build/snapshots/frames.json build/snapshots/{}.png 0.6",
